FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
  && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md /app/
COPY mega_ai /app/mega_ai
COPY alembic /app/alembic
COPY alembic.ini /app/
RUN pip install --no-cache-dir pip setuptools wheel && pip install --no-cache-dir -e .
ENV PYTHONUNBUFFERED=1
CMD bash -lc "alembic upgrade head && dramatiq mega_ai.workers.tasks --processes ${DRAMATIQ_PROCESSES:-2} --threads ${DRAMATIQ_THREADS:-8}"
